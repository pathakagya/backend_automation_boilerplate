# ============================================================
# config/.env.example — Copy to config/.env.<env> or config/.env
# ============================================================
# ENV decides the file to load (config/.env.dev, config/.env.staging, etc.)
# Framework is environment-variable driven.
# ============================================================

ENV=dev

# Database (only needed for DB-backed tests)
DB_ADAPTER_CLASS=project.db.adapter:ProjectDatabaseAdapter
DB_ENGINE=mysql                 # DB used in the project
DATABASE_HOST=hostmane
DATABASE_PORT=port
DATABASE_NAME=db_name
DATABASE_USER=db_user
DATABASE_PASSWORD=db_user_password


# API
API_BASE_URL=https://api.example.com
API_AUTH_TYPE=bearer
API_TOKEN=CHANGE_ME
API_USERNAME=qa_user
API_PASSWORD=CHANGE_ME
API_MAX_RETRIES=2
API_RETRY_BACKOFF=0.3
API_RETRY_UNSAFE_METHODS=false
API_TIMEOUT=30
